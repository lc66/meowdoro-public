def targets_of(config):
    """The Meowdoros this machine sends to: `{"name", "targets": [{"relay", "channel", "key", "added"}]}`.
    Before 0.5.0, remote.json held one, as top-level relay, channel and key."""
    if not config:
        return []
    if "targets" in config:
        return [target for target in config["targets"] if target.get("relay") and target.get("channel") and target.get("key")]
    if config.get("channel"):
        return [{"relay": config["relay"], "channel": config["channel"], "key": config["key"]}]
    return []


