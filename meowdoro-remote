def claude_desktop_session_file(session_id, home=None):
    """Claude Desktop's local_<uuid>.json for this Claude Code session (its cliSessionId), or None."""
    folder = os.path.join(home or os.path.expanduser("~"), "Library", "Application Support", "Claude", "claude-code-sessions")
    for root, _, files in os.walk(folder):
        for name in files:
            if not (name.startswith("local_") and name.endswith(".json")):
                continue
            path = os.path.join(root, name)
            try:
                with open(path) as f:
                    if json.load(f).get("cliSessionId") == session_id:
                        return path
            except Exception:
                pass
    return None


def claude_desktop_last_focused(path):
    """When the session was last opened in Claude Desktop (lastFocusedAt, milliseconds), in seconds; None if unknown.
    It notes the moment a session is opened, not how long it stays open."""
    try:
        with open(path) as f:
            millis = json.load(f).get("lastFocusedAt")
        return millis / 1000 if isinstance(millis, (int, float)) and not isinstance(millis, bool) else None
    except Exception:
        return None


def claude_desktop_turn_summary(path):
    """What Claude Desktop made of the session's last turn (postTurnSummary): (the reply it is about, the question
    when the turn ended on one — "blocked", the yellow dot in its sidebar — else None). None when there's none."""
    try:
        with open(path) as f:
            summary = json.load(f).get("postTurnSummary")
        reply = summary.get("summarizes_uuid")
        if not isinstance(reply, str):
            return None
        if summary.get("status_category") != "blocked":
            return reply, None
        asked = summary.get("needs_action").strip() if isinstance(summary.get("needs_action"), str) else ""
        return reply, (asked[:200] or "has a question")
    except Exception:
        return None


def _claude_reply_uuid(line):
    if b'"assistant"' not in line:
        return None
    entry = _json(line)
    if not entry or entry.get("type") != "assistant" or entry.get("isSidechain") is True:
        return None
    return entry.get("uuid") if isinstance(entry.get("uuid"), str) else None


def claude_last_reply(transcript):
    """The id of the session's last reply (subagents aside): what Claude Desktop's turn summary is about."""
    return last_line(transcript, _claude_reply_uuid)


def chatgpt_unread(codex_home=None):
    """The Codex threads ChatGPT lists as unread: electron-thread-read-state-v1.unreadByIdentity (account → host →
    thread ids) in .codex-global-state.json. None when it can't be read. (Codex's own thread_read_receipts table
    looks like the place, but ChatGPT doesn't clear it on reading.)"""
    try:
        with open(os.path.join(codex_home or codex_config_dir(), ".codex-global-state.json")) as f:
            accounts = json.load(f)["electron-thread-read-state-v1"]["unreadByIdentity"]
        unread = set()
        for hosts in accounts.values():
            for threads in (hosts.values() if isinstance(hosts, dict) else []):
                unread.update(thread for thread in (threads if isinstance(threads, list) else []) if isinstance(thread, str))
        return unread
    except Exception:
        return None


def chatgpt_read(on_list, saw_unread, finished, now):
    """Read in ChatGPT: off its unread list after being on it, or never put there (the thread was open)."""
    return not on_list and (saw_unread or now - finished >= CHATGPT_UNREAD_DELAY)


def inside_codex_desktop(pid):
    """Codex runs inside ChatGPT (or the Codex app): its process is a program in that app's bundle."""
    name = _process(pid)[0] if pid else None
    return bool(name) and ("/ChatGPT.app/" in name or "/Codex.app/" in name)


def plugin_state(agent):
    """This helper's plugin in the agent's config: "on", "off" (installed, switched off) or None (not installed).
    Claude Code: enabledPlugins in settings.json. Codex: [plugins."meowdoro-remote@meowdoro-remote"] in config.toml,
    where enabled = false means switched off."""
    try:
        if agent == "claude":
            with open(os.path.join(claude_config_dir(), "settings.json")) as f:
                enabled = (json.load(f).get("enabledPlugins") or {}).get(PLUGIN_ID)
            return None if enabled is None else "on" if enabled is True else "off"
        with open(os.path.join(codex_config_dir(), "config.toml")) as f:
            lines = [line.strip() for line in f.read().splitlines()]
    except Exception:
        return None
    state, section = None, False
    for line in lines:
        if line.startswith("["):
            section = line == f'[plugins."{PLUGIN_ID}"]'
            state = "on" if section and state is None else state
        elif section and line.replace(" ", "") == "enabled=false":
            state = "off"
    return state


def plugin_enabled(agent):
    return plugin_state(agent) == "on"


def codex_hooks_waiting(tool, timeout=15):
    """How many of this helper's hooks Codex skips until the user trusts them (/hooks in Codex, ChatGPT → Settings →
    Hooks), as `codex app-server` tells through hooks/list — the same question the app asks (CodexHookReview.swift).
    None when it can't tell."""
    messages = [{"jsonrpc": "2.0", "id": 1, "method": "initialize", "params": {"clientInfo": {"name": "meowdoro-remote", "version": VERSION}}},
                {"jsonrpc": "2.0", "method": "initialized"},
                {"jsonrpc": "2.0", "id": 2, "method": "hooks/list", "params": {"cwds": [os.path.expanduser("~")]}}]
    try:
        process = subprocess.Popen([tool, "app-server"], stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
    except Exception:
        return None
    try:
        # Stdin stays open until the reply: on EOF it quits without answering.
        process.stdin.write("".join(json.dumps(message) + "\n" for message in messages).encode())
        process.stdin.flush()
        deadline, buffer = time.time() + timeout, b""
        while time.time() < deadline:
            ready, _, _ = select.select([process.stdout], [], [], max(0, deadline - time.time()))
            if not ready:
                break
            chunk = os.read(process.stdout.fileno(), 1 << 16)
            if not chunk:
                break
            buffer += chunk
            *lines, buffer = buffer.split(b"\n")
            for line in lines:
                message = _json(line)
                if not message or message.get("id") != 2 or not isinstance(message.get("result"), dict):
                    continue
                entries = message["result"].get("data") or []
                hooks = entries[0].get("hooks") if entries and isinstance(entries[0], dict) else []
                ours = [hook for hook in hooks or [] if isinstance(hook, dict) and hook.get("pluginId") == PLUGIN_ID]
                return sum(1 for hook in ours if hook.get("trustStatus") in ("untrusted", "modified"))
        return None
    except Exception:
        return None
    finally:
        try:
            process.kill()
            process.wait(timeout=5)
            process.stdin.close()
            process.stdout.close()
        except Exception:
            pass


def agent_states(connect=False, tried=None, previous=None):
    """For the Mac's Settings: each agent with this helper's plugin on ("connected", or for Codex "needs_approval"
    while it skips the hooks), found here without it ("not_connected"), or not on this machine ("not_found").
    With `connect`, an agent found here that never had the plugin gets it, once per agent in `tried` (setup said
    this machine's agents go to the Mac; one the user switched off stays off). Codex's approval is asked again only
    while it was missing: once trusted, it stays so until the plugin changes, which only setup does."""
    states = {}
    for agent, folder in (("claude", claude_config_dir()), ("codex", codex_config_dir())):
        state = plugin_state(agent)
        tool = None
        if state is None and connect and agent not in (tried if tried is not None else set()):
            tool = find_agent(agent)
            if tool:
                if tried is not None:
                    tried.add(agent)
                if not os.path.isfile(os.path.join(PLUGINS, ".claude-plugin", "marketplace.json")):
                    write_plugin(os.path.abspath(__file__))
                ok = (install_claude if agent == "claude" else install_codex)(tool)
                print(f"{time.strftime('%Y-%m-%d %H:%M:%S')} {agent} found{_whose(tool)}: plugin {'installed' if ok else 'install failed'}", flush=True)
                state = plugin_state(agent)
        if state == "on":
            states[agent] = "connected"
            if agent == "codex" and (previous or {}).get("codex") != "connected":
                codex = tool or find_agent("codex")
                # Couldn't tell: say nothing rather than send the user looking for a problem that may not be there.
                states[agent] = "needs_approval" if codex and codex_hooks_waiting(codex) else "connected"
        elif state == "off" or os.path.isdir(folder) or tool or find_agent(agent):
            states[agent] = "not_connected"
        else:
            states[agent] = "not_found"
    return states


