def socket_path():
    """~/.meowdoro/remote.sock, or a private folder in /tmp when the home path is too long for a Unix socket (~104 bytes)."""
    path = os.path.join(HOME, "remote.sock")
    if len(path.encode()) < 100:
        return path
    folder = f"/tmp/meowdoro-{os.getuid()}"
    try:
        os.mkdir(folder, 0o700)
    except FileExistsError:
        pass
    info = os.lstat(folder)
    # Someone else's folder (or a link) in the shared /tmp: don't use it.
    if info.st_uid != os.getuid() or (info.st_mode & 0o077) or not os.path.isdir(folder) or os.path.islink(folder):
        raise OSError("unsafe socket folder")
    return os.path.join(folder, "remote.sock")


def hook(agent):
    try:
        if not os.path.exists(CONFIG):
            return  # not set up (or uninstalled while an agent still had the plugin)
        raw = sys.stdin.buffer.read(1 << 20)
        payload = json.loads(raw.decode("utf-8", "replace"))
        event = compact(agent, payload)
        if event is None:
            return
        event["pid"] = agent_pid()
        # For the daemon, which reads the context numbers from it; the path itself never leaves the machine.
        if isinstance(payload.get("transcript_path"), str):
            event["transcript"] = payload["transcript_path"]
        event["t"] = time.time()
        line = (json.dumps(event) + "\n").encode()
        if not _hand_over(line):
            _start_daemon()
            for _ in range(20):
                time.sleep(0.05)
                if _hand_over(line):
                    return
    except Exception:
        pass


def _hand_over(line):
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
            s.settimeout(0.5)
            s.connect(socket_path())
            s.sendall(line)
        return True
    except OSError:
        return False


def _start_daemon():
    try:
        os.makedirs(HOME, mode=0o700, exist_ok=True)
        log = open(LOG, "ab")
        subprocess.Popen([sys.executable, os.path.abspath(__file__), "daemon"], stdin=subprocess.DEVNULL,
                         stdout=log, stderr=log, start_new_session=True, close_fds=True)
    except Exception:
        pass


