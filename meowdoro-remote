def find_agent(agent, home=None, mac=None, apps=None):
    """The agent's command: the first executable file among agent_candidates."""
    return next((place for place in agent_candidates(agent, home, mac, apps) if _executable(place)), None)


def agent_candidates(agent, home=None, mac=None, apps=None):
    """Every place to try, in order: the PATH, paths, then on a Mac macPaths (newest version first) and macApps
    (found by bundle ID, else the fallback paths; the paths inside, then a file called search under Resources)."""
    home = home or os.path.expanduser("~")
    mac = sys.platform == "darwin" if mac is None else mac
    apps = apps or _apps_with_bundle_id
    places = [os.path.join(folder, agent) for folder in os.environ.get("PATH", "").split(os.pathsep) if folder]
    spec = agent_locations().get("agents", {}).get(agent)
    if not spec:
        return places
    places += [_expand_home(path, home) for path in spec.get("paths", [])]
    if not mac:
        return places
    for pattern in spec.get("macPaths", []):
        places += _glob_newest_first(_expand_home(pattern, home))
    for entry in spec.get("macApps", []):
        for app in _app_folders(entry, apps):
            places += [os.path.join(app, inside) for inside in entry.get("inside", [])]
            if entry.get("search"):
                places += _search(entry["search"], os.path.join(app, "Contents", "Resources"))
    return places


def _app_folders(entry, apps):
    folders = []
    for bundle_id in entry.get("bundleIDs", []):
        folders += [app for app in apps(bundle_id) if app not in folders]
    folders += [path for path in entry.get("fallback", []) if path not in folders and os.path.isdir(path)]
    return folders


def _apps_with_bundle_id(bundle_id):
    """Every copy of the app with this bundle ID, by Spotlight."""
    try:
        found = subprocess.run(["mdfind", f"kMDItemCFBundleIdentifier == '{bundle_id}'"], capture_output=True, text=True, timeout=5)
        return [path for path in found.stdout.split("\n") if path.endswith(".app")]
    except Exception:
        return []


def _expand_home(path, home):
    return home if path == "~" else home + path[1:] if path.startswith("~/") else path


def _natural(text):
    """"2.1.299" after "2.1.95", as the app's numeric compare sorts them."""
    return [int(part) if part.isdigit() else part for part in re.split(r"(\d+)", text)]


def _glob_newest_first(pattern):
    """* matches one path component (no hidden entries); matches newest version first."""
    matches = [""]
    for component in [part for part in pattern.split("/") if part]:
        found = []
        for base in matches:
            if "*" in component:
                try:
                    entries = os.listdir(base or "/")
                except OSError:
                    entries = []
                found += [base + "/" + entry for entry in entries if not entry.startswith(".") and fnmatch.fnmatchcase(entry, component)]
            else:
                found.append(base + "/" + component)
        matches = found
    return sorted(matches, key=_natural, reverse=True)


def _search(name, folder):
    """Executable files called name under folder, at most 5 levels down, in path order."""
    found = []
    for root, folders, files in os.walk(folder):
        # Files here are depth + 1 levels down, as the app's enumerator counts: up to 5.
        depth = 0 if root == folder else os.path.relpath(root, folder).count(os.sep) + 1
        if depth >= 4:
            folders[:] = []
        found += [os.path.join(root, file) for file in files if file == name and _executable(os.path.join(root, file))]
    return sorted(found)


def _executable(path):
    return os.path.isfile(path) and os.access(path, os.X_OK)


def _whose(tool):
    """" (the copy in ChatGPT)" for a desktop app's copy, which the user may not know is there; nothing for PATH."""
    if "/Application Support/Claude/" in tool:
        return " (the copy in Claude Desktop)"
    app = next((part for part in tool.split("/") if part.endswith(".app") and part != "claude.app" and part != "CodexCLI.app"), None)
    return f" (the copy in {app[:-4]})" if app else ""


def setup(relay, code, name=None):
    """Adds the Meowdoro whose line this is to the ones this machine sends to. The same line again (same channel)
    replaces its entry instead: a new relay address, an update."""
    data = json.loads(unb64u(code))
    old = load_config() or {}
    targets = [target for target in targets_of(old) if target["channel"] != data["c"]]
    targets.append({"relay": relay.rstrip("/"), "channel": data["c"], "key": data["k"], "added": int(time.time())})
    dropped = len(targets) - MAX_TARGETS
    config = {"name": name or old.get("name") or data.get("n") or socket.gethostname().split(".")[0], "targets": targets[-MAX_TARGETS:]}
    save_config(config)
    stop_daemon()
    tools = [(agent, find_agent(agent)) for agent in ("claude", "codex")]
    # Before the folder gets the new plugin: the agents may still read the old one while removing it.
    replaced = {agent for agent, tool in tools if tool and remove_old_plugin(agent, tool)}
    write_plugin(os.path.abspath(__file__))
    print(f"Meowdoro: this machine shows up as “{config['name']}”.")
    # Hello to the Mac whose line this is: it lists this machine in Settings now, not only after an agent's first event.
    target = Target(config["targets"][-1])
    status = target.deliver({"type": "heartbeat", "machine": config["name"], "sessions": [], "t": time.time()}, timeout=8)
    if status is not None and 200 <= status < 300:
        print("  Your Mac can see it now: Settings → Remote agents.")
    else:
        print(f"  Couldn't reach the relay ({status or 'no answer'} from {target.relay}); it shows up once it can.")
    if len(config["targets"]) > 1:
        print(f"  It sends to {len(config['targets'])} Meowdoros now: meowdoro-remote list")
    if dropped > 0:
        print(f"  At most {MAX_TARGETS}: the oldest one was dropped.")
    for agent, tool in tools:
        if tool:
            ok = (install_claude if agent == "claude" else install_codex)(tool)
            note = f" (replaces {OLD_PLUGIN}@{OLD_PLUGIN} from an older helper)" if agent in replaced else ""
            print(f"  {agent}: {'plugin installed' if ok else 'install failed — see the commands in Meowdoro'}{_whose(tool)}{note}")
        else:
            print(f"  {agent}: not found on this machine (looked on PATH, in the usual install folders and desktop apps)")
    if status is not None and 200 <= status < 300:
        # Which agents have the plugin now: their tiles under this machine in the Mac's Settings.
        target.deliver({"type": "heartbeat", "machine": config["name"], "sessions": [], "agents": agent_states(), "t": time.time()}, timeout=8)
    print("Agent sessions that are already running pick it up after a restart.")
    print("Codex runs plugin hooks only after you trust them: /hooks in the Codex CLI.")


def stop_daemon():
    """A running daemon keeps the code it started with: stop it, and the next hook starts one with this code
    (and the new key)."""
    try:
        lock = open(LOCK, "a+")
    except OSError:
        return
    with lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return  # none running
        except OSError:
            pass
        lock.seek(0)
        pid = lock.read().strip()
    if pid.isdigit():
        try:
            os.kill(int(pid), signal.SIGTERM)
        except OSError:
            pass
    else:
        # Helpers before 0.3.0 don't write their pid.
        run(["pkill", "-u", str(os.getuid()), "-f", "meowdoro-remote daemon"])


def write_plugin(script):
    command = f"python3 {shell_quote(script)} hook"
    def hook_table(agent):
        table = {}
        for event, matcher in HOOKS[agent]:
            group = {"hooks": [{"type": "command", "command": f"{command} {agent}", "timeout": 3}]}
            if matcher:
                group = {"matcher": matcher, **group}
            table[event] = [group]
        return table
    description = "Shows what your coding agents on this machine are doing in the Meowdoro island on your Mac. It only reports status."
    folder = f"plugins/{PLUGIN}"
    files = {
        ".claude-plugin/marketplace.json": {"name": PLUGIN, "owner": {"name": "Meowdoro"}, "plugins": [
            {"name": PLUGIN, "source": f"./{folder}", "description": description, "version": VERSION}]},
        ".agents/plugins/marketplace.json": {"name": PLUGIN, "interface": {"displayName": "Meowdoro Remote"}, "plugins": [
            {"name": PLUGIN, "source": {"source": "local", "path": f"./{folder}"},
             "policy": {"installation": "AVAILABLE", "authentication": "ON_USE"}, "category": "Productivity"}]},
        f"{folder}/.claude-plugin/plugin.json": {"name": PLUGIN, "version": VERSION, "description": description,
                                                 "author": {"name": "Meowdoro"}},
        f"{folder}/hooks/hooks.json": {"description": "Meowdoro remote status hooks: report only.", "hooks": hook_table("claude")},
        f"{folder}/.codex-plugin/plugin.json": {"name": PLUGIN, "version": VERSION, "description": description,
                                                "author": {"name": "Meowdoro"}, "hooks": {"hooks": hook_table("codex")},
                                                "interface": {"displayName": "Meowdoro Remote", "category": "Productivity"}},
    }
    # Where helpers before 0.5.0 kept the plugin.
    shutil.rmtree(os.path.join(PLUGINS, "plugins", OLD_PLUGIN), ignore_errors=True)
    for path, content in files.items():
        full = os.path.join(PLUGINS, path)
        os.makedirs(os.path.dirname(full), exist_ok=True)
        with open(full, "w") as f:
            json.dump(content, f, indent=2)


def install_claude(tool):
    return run([tool, "plugin", "install", PLUGIN, "--marketplace", PLUGINS, "--scope", "user"])


def install_codex(tool):
    # Adding a marketplace that is already there fails harmlessly; the install is what counts.
    run([tool, "plugin", "marketplace", "add", PLUGINS])
    return run([tool, "plugin", "add", PLUGIN_ID])


def remove_old_plugin(agent, tool):
    """Takes away the meowdoro@meowdoro an older helper installed, but only when its marketplace is this helper's
    folder: the same name from anywhere else is Meowdoro's own plugin on this machine. True when it was there."""
    folder = marketplace_folder(agent, tool, OLD_PLUGIN)
    if not folder or not same_folder(folder, PLUGINS):
        return False
    old_id = f"{OLD_PLUGIN}@{OLD_PLUGIN}"
    run([tool, "plugin", "uninstall", old_id, "--scope", "user"] if agent == "claude" else [tool, "plugin", "remove", old_id])
    run([tool, "plugin", "marketplace", "remove", OLD_PLUGIN])
    return True


def marketplace_folder(agent, tool, name):
    """The folder the agent's marketplace `name` comes from, or None: from the agent's own listing, or, when that
    can't say (older versions), from what it wrote when the marketplace was added."""
    try:
        result = subprocess.run([tool, "plugin", "marketplace", "list", "--json"], capture_output=True, timeout=120)
        listed = json.loads(result.stdout) if result.returncode == 0 else None
    except Exception:
        listed = None
    # Claude Code: [{"name", "path", ...}]. Codex: {"marketplaces": [{"name", "root", "marketplaceSource": {"source"}}]}.
    entries = listed.get("marketplaces") if isinstance(listed, dict) else listed
    if not isinstance(entries, list):
        return configured_marketplace_folder(agent, name)
    for entry in entries:
        if isinstance(entry, dict) and entry.get("name") == name:
            source = entry.get("marketplaceSource") if isinstance(entry.get("marketplaceSource"), dict) else {}
            folder = entry.get("path") or entry.get("root") or source.get("source")
            return folder if isinstance(folder, str) else None
    return None


def configured_marketplace_folder(agent, name):
    """Claude Code's plugins/known_marketplaces.json, or `source` under [marketplaces.<name>] in Codex's config.toml."""
    try:
        if agent == "claude":
            with open(os.path.join(claude_config_dir(), "plugins", "known_marketplaces.json")) as f:
                entry = json.load(f).get(name) or {}
            folder = (entry.get("source") or {}).get("path") or entry.get("installLocation")
            return folder if isinstance(folder, str) else None
        with open(os.path.join(codex_config_dir(), "config.toml")) as f:
            lines = f.read().splitlines()
    except Exception:
        return None
    section = None
    for line in (line.strip() for line in lines):
        if line.startswith("["):
            section = line.replace(" ", "")
        elif section in (f"[marketplaces.{name}]", f'[marketplaces."{name}"]'):
            # A TOML basic string (JSON's escapes, near enough) or a literal one.
            found = re.match(r"""source\s*=\s*(?:("(?:[^"\\]|\\.)*")|'([^']*)')""", line)
            if found:
                try:
                    return json.loads(found.group(1)) if found.group(1) else found.group(2)
                except ValueError:
                    return None
    return None


def same_folder(a, b):
    # Claude Code keeps the path it was given, Codex the resolved one.
    return os.path.realpath(os.path.expanduser(a)) == os.path.realpath(b)


def list_targets():
    config = load_config()
    targets = targets_of(config)
    if not targets:
        print("Meowdoro: not set up on this machine.")
        return
    print(f"Meowdoro: this machine shows up as “{config.get('name') or socket.gethostname().split('.')[0]}” and sends to:")
    for number, target in enumerate(targets, 1):
        added = time.strftime("%Y-%m-%d %H:%M", time.localtime(target["added"])) if target.get("added") else "before 0.5.0"
        host = urllib.parse.urlsplit(target["relay"]).netloc or target["relay"]
        print(f"  {number}. {host}, channel {target['channel'][:6]}…, added {added}")
    print("Stop sending to one: meowdoro-remote remove <number>")


def remove(number):
    """Stops sending to one Meowdoro, e.g. one that turned remote agents off or made a new key. The last one goes
    with the whole helper."""
    config = load_config()
    targets = targets_of(config)
    if not number.isdigit() or not 1 <= int(number) <= len(targets):
        print(f"Meowdoro: no {number} in the list (meowdoro-remote list).")
        return
    del targets[int(number) - 1]
    if not targets:
        print("Meowdoro: that was the only one.")
        return uninstall()
    save_config({"name": config.get("name"), "targets": targets})
    stop_daemon()  # the next hook starts one that sends to the rest
    print(f"Meowdoro: removed. This machine sends to {len(targets)} Meowdoro{'s' if len(targets) > 1 else ''} now.")


def uninstall():
    # The config goes first, so no hook starts a new daemon meanwhile; then the running one, which would keep
    # the key in memory and the machine online on the Mac until it quits after ten idle minutes.
    try:
        os.unlink(CONFIG)
    except FileNotFoundError:
        pass
    stop_daemon()
    # Only the helper's own plugins: a Meowdoro running on this machine keeps meowdoro@meowdoro.
    for agent, args in (("claude", ["plugin", "uninstall", PLUGIN_ID, "--scope", "user"]), ("codex", ["plugin", "remove", PLUGIN_ID])):
        tool = find_agent(agent)
        if tool:
            remove_old_plugin(agent, tool)
            run([tool] + args)
            run([tool, "plugin", "marketplace", "remove", PLUGIN])
    for path in (socket_path(), LOCK):
        try:
            os.unlink(path)
        except FileNotFoundError:
            pass
    shutil.rmtree(PLUGINS, ignore_errors=True)
    print("Meowdoro: removed from this machine.")


def run(args):
    try:
        return subprocess.run(args, capture_output=True, timeout=120).returncode == 0
    except Exception:
        return False


def shell_quote(text):
    return "'" + text.replace("'", "'\\''") + "'"


def main(argv):
    if len(argv) >= 3 and argv[1] == "hook":
        hook(argv[2])
    elif len(argv) >= 2 and argv[1] == "daemon":
        daemon()
    elif len(argv) >= 4 and argv[1] == "setup":
        setup(argv[2], argv[3], argv[4] if len(argv) > 4 else None)
    elif len(argv) >= 2 and argv[1] == "list":
        list_targets()
    elif len(argv) >= 3 and argv[1] == "remove":
        remove(argv[2])
    elif len(argv) >= 2 and argv[1] == "uninstall":
        uninstall()
    else:
        print(__doc__)


if __name__ == "__main__":
    main(sys.argv)
