def _shown(numbers):
    """What the island shows of the numbers: the context ring's percent and each limit's whole percent."""
    context, limits = numbers["context"], numbers["limits"]
    return (context and (context["percent"], context["window"]),
            limits and tuple((window["minutes"], _rounded(window["percent"])) for window in limits["windows"]))


class Target:
    """One Meowdoro this machine sends to: its relay, channel and key, with a queue and retries of its own, so a relay
    that's down for one Mac doesn't hold up the others."""

    def __init__(self, target):
        self.relay = target["relay"].rstrip("/")
        self.channel = target["channel"]
        self.key = unb64u(target["key"])
        self.outbox = queue.Queue(maxsize=500)

    def send(self, message):
        try:
            self.outbox.put_nowait(message)
        except queue.Full:
            pass

    def sender(self):
        backoff = 1
        while True:
            message = self.outbox.get()
            while not self.post(message):
                time.sleep(backoff)
                backoff = min(backoff * 2, 60)
            backoff = 1

    def envelope(self, message, nonce=None):
        """What the relay gets: `{"n": nonce, "c": ciphertext + tag}`, sealed with the channel as associated data."""
        nonce = nonce or os.urandom(12)
        # Every message says which protocol and helper made it: the Mac shows the helper version per machine.
        plaintext = json.dumps(dict(message, v=PROTOCOL, helper=VERSION, t=message.get("t", time.time()))).encode()
        return json.dumps({"n": b64u(nonce), "c": b64u(seal(self.key, nonce, plaintext, self.channel.encode()))}).encode()

    def deliver(self, message, timeout=10):
        """POSTs one message: the relay's HTTP status, or None when it can't be reached."""
        request = urllib.request.Request(f"{self.relay}/v1/c/{self.channel}/events", data=self.envelope(message), method="POST",
                                         headers={"content-type": "application/json", "user-agent": f"meowdoro-remote/{VERSION}"})
        try:
            with urllib.request.urlopen(request, timeout=timeout) as response:
                return response.status
        except urllib.error.HTTPError as error:
            return error.code
        except Exception:
            return None

    def post(self, message):
        """Done with this message: delivered, or refused for good. A malformed event won't get better by retrying;
        a flood limit or an outage will."""
        status = self.deliver(message)
        return status is not None and status not in (429, 500, 502, 503, 504)


class Daemon:
    def __init__(self, config):
        self.targets = [Target(target) for target in targets_of(config)]
        self.machine = config.get("name") or socket.gethostname().split(".")[0]
        self.inbox = queue.Queue()
        # "agent:session" -> {"pid", "kind", "sent", "app", "transcript", "read", "context", "shown",
        #                     "finished", "read_sent", "saw_unread", "file", "in_app", "summarized"} (see check_apps)
        self.sessions = {}
        # Plan limits per agent: per account, so any of its sessions may bring a newer reading.
        self.limits = {}
        self.lock = threading.Lock()
        self.idle_since = time.time()
        # agent_states(), refreshed every AGENTS_EVERY; ChatGPT's unread list as of its file's last change.
        self.agents, self.agents_at = None, 0
        # Agents this daemon already tried to give the plugin.
        self.tried = set()
        self.chatgpt = None

    def process(self):
        """One event at a time, in the order the hooks ran: a slow read must not let "working" overtake "finished"."""
        while True:
            try:
                self.receive(self.inbox.get())
            except Exception:
                pass

    def receive(self, event):
        key = f"{event['agent']}:{event['session_id']}"
        agent, name = event["agent"], event["hook_event_name"]
        # Neither leaves the machine: the pid is for liveness, the transcript for the numbers.
        pid, transcript = event.pop("pid", None), event.pop("transcript", None)
        now = time.time()
        with self.lock:
            self.idle_since = now
            if name == "SessionEnd":
                self.sessions.pop(key, None)
            else:
                session = self.sessions.setdefault(key, {"pid": None, "kind": None, "sent": 0, "app": None,
                                                         "transcript": None, "read": 0, "context": None, "shown": None,
                                                         "finished": None, "read_sent": False, "saw_unread": False,
                                                         "file": None, "in_app": None, "summarized": None})
                session["pid"] = pid or session["pid"]
                if isinstance(transcript, str) and transcript:
                    session["transcript"] = transcript
        if name == "SessionEnd":
            return self.send(dict(event, type="event", machine=self.machine))
        self.read_numbers(agent, session, name, now)
        with self.lock:
            numbers = {"context": session["context"], "limits": self.limits.get(agent)}
            # A new figure for the island is worth an event of its own.
            news = _shown(numbers) != session["shown"]
            app = event.get("mcp_server") or (event.get("tool_name", "").split("__")[1] if event.get("tool_name", "").startswith("mcp__") else None)
            if name == "PostToolUse" and session["kind"] == "working" and now - session["sent"] < WORKING_RESEND and app == session["app"] and not news:
                return
            session["kind"] = "working" if name in WORKING else name
            if name in FINISHED:
                # When the reply came, by this machine's clock, like the apps' notes on reading it.
                session.update(finished=event.get("t", now), read_sent=False, saw_unread=False, summarized=None)
            else:
                session["finished"] = None
            session["sent"] = now
            session["app"] = app or session["app"]
            session["shown"] = _shown(numbers)
        # Every event carries the latest numbers, so a Mac that missed some (or restarted) catches up with the next one.
        self.send(dict(event, type="event", machine=self.machine, **{field: value for field, value in numbers.items() if value}))

    def read_numbers(self, agent, session, name, now):
        if not session["transcript"] or (name not in READ_NOW and now - session["read"] < READ_EVERY):
            return
        session["read"] = now
        context = read_context(agent, session["transcript"], (session["context"] or {}).get("window"))
        limits = read_limits(agent, session["transcript"])
        with self.lock:
            if context:
                session["context"] = context
            if limits and limits["at"] >= (self.limits.get(agent) or {}).get("at", 0):
                self.limits[agent] = limits

    def send(self, message):
        """To every Meowdoro this machine sends to, each sealed with its own key."""
        for target in self.targets:
            target.send(message)

    def watch(self):
        last_beat = 0
        while True:
            time.sleep(LIVENESS_EVERY)
            now = time.time()
            closed = []
            with self.lock:
                for key, session in list(self.sessions.items()):
                    if session["pid"] and not alive(session["pid"]):
                        closed.append(key)
                        del self.sessions[key]
                alive_keys = list(self.sessions)
                if self.sessions:
                    self.idle_since = now
                idle = now - self.idle_since
            for key in closed:
                agent, session_id = key.split(":", 1)
                self.send({"type": "event", "agent": agent, "session_id": session_id, "hook_event_name": "SessionEnd",
                           "project": "—", "machine": self.machine, "t": now})
            try:
                self.check_apps(now)
            except Exception:
                pass
            if now - self.agents_at >= AGENTS_EVERY:
                try:
                    self.agents = agent_states(connect=True, tried=self.tried, previous=self.agents)
                except Exception:
                    pass
                self.agents_at = now
            if now - last_beat >= HEARTBEAT_EVERY or closed:
                self.send(self.heartbeat(alive_keys, now))
                last_beat = now
            if idle > QUIT_AFTER_IDLE and all(target.outbox.empty() for target in self.targets):
                self.send(dict(self.heartbeat([], now), bye=True))
                time.sleep(3)
                os._exit(0)

    def heartbeat(self, sessions, now):
        message = {"type": "heartbeat", "machine": self.machine, "sessions": sessions, "t": now}
        if self.agents:
            message["agents"] = self.agents
        return message

    def check_apps(self, now, home=None, codex_home=None):
        """What Claude Desktop and ChatGPT on this machine say about finished sessions, told to each Mac once (the
        app's own check, AgentHub.checkAgentApps, has the same rules):
        - read: Claude Desktop opened the session after the reply (lastFocusedAt); ChatGPT took the thread off its
          unread list, or never put it there (only threads running inside ChatGPT: a terminal one never is).
        - question: Claude Desktop's summary of this very reply says it ended on a question for the user (its yellow
          dot), with what it asks. The summary comes seconds after the reply; looked for up to CLAUDE_SUMMARY_WAIT."""
        with self.lock:
            waiting = [(key, dict(session)) for key, session in self.sessions.items() if session["finished"] and (
                not session["read_sent"] or (key.startswith("claude:") and session["summarized"] is None
                                             and now - session["finished"] < CLAUDE_SUMMARY_WAIT))]
        if not waiting:
            return
        finished = {key: session["finished"] for key, session in waiting}
        updates, read, questions = {}, [], {}
        for key, session in waiting:
            agent, session_id = key.split(":", 1)
            change = {}
            if agent == "claude":
                path = session["file"]
                if path is None:
                    path = change["file"] = claude_desktop_session_file(session_id, home) or False
                if path and not session["read_sent"]:
                    focused = claude_desktop_last_focused(path)
                    if focused is not None and focused > session["finished"]:
                        read.append(key)
                if path and session["summarized"] is None and session["transcript"]:
                    summary = claude_desktop_turn_summary(path)
                    # Until Claude Desktop sums up this reply, its file still holds the last turn's summary.
                    if summary and summary[0] == claude_last_reply(session["transcript"]):
                        change["summarized"] = True
                        if summary[1]:
                            questions[key] = summary[1]
            elif agent == "codex" and not session["read_sent"]:
                in_app = session["in_app"]
                if in_app is None:
                    in_app = change["in_app"] = inside_codex_desktop(session["pid"])
                unread = self.chatgpt_unread(codex_home) if in_app else None
                if unread is not None:
                    on_list = session_id in unread
                    if on_list:
                        change["saw_unread"] = True
                    if chatgpt_read(on_list, session["saw_unread"], session["finished"], now):
                        read.append(key)
            updates[key] = change
        with self.lock:
            for key, change in updates.items():
                if key in self.sessions and self.sessions[key]["finished"] == finished[key]:
                    self.sessions[key].update(change, **({"read_sent": True} if key in read else {}))
                else:
                    # A new event came meanwhile: this was about a reply that's no longer the last.
                    read = [k for k in read if k != key]
                    questions.pop(key, None)
        for key, question in questions.items():
            agent, session_id = key.split(":", 1)
            self.send({"type": "question", "agent": agent, "session_id": session_id, "machine": self.machine, "question": question, "t": now})
        for key in read:
            agent, session_id = key.split(":", 1)
            self.send({"type": "read", "agent": agent, "session_id": session_id, "machine": self.machine, "t": now})

    def chatgpt_unread(self, codex_home=None):
        """chatgpt_unread(), read again only when its file changes: it's large (hundreds of kilobytes)."""
        modified = _modified(os.path.join(codex_home or codex_config_dir(), ".codex-global-state.json"))
        if not self.chatgpt or self.chatgpt[0] != modified:
            unread = chatgpt_unread(codex_home)
            if unread is None:
                return None
            self.chatgpt = (modified, unread)
        return self.chatgpt[1]


def daemon():
    os.makedirs(HOME, mode=0o700, exist_ok=True)
    lock = open(LOCK, "a+")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        return  # another daemon is running
    # For setup, which stops a running daemon so the next hook starts one with the new code.
    lock.truncate(0)
    lock.write(str(os.getpid()))
    lock.flush()
    config = load_config()
    if not targets_of(config):
        return
    worker = Daemon(config)

    class Handler(socketserver.StreamRequestHandler):
        def handle(self):
            for line in self.rfile:
                try:
                    worker.inbox.put(json.loads(line))
                except Exception:
                    pass

    path = socket_path()
    try:
        os.unlink(path)
    except FileNotFoundError:
        pass
    server = socketserver.ThreadingUnixStreamServer(path, Handler)
    os.chmod(path, 0o600)
    threading.Thread(target=worker.process, daemon=True).start()
    for target in worker.targets:
        threading.Thread(target=target.sender, daemon=True).start()
    threading.Thread(target=worker.watch, daemon=True).start()
    worker.send({"type": "heartbeat", "machine": worker.machine, "sessions": [], "t": time.time()})
    server.serve_forever()


