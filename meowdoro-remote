AGENT_LOCATIONS = json.loads('{"about":["Where to look for each agent\'s command-line tool, for Meowdoro on the Mac (AgentLocations.swift) and the remote helper (remote/meowdoro-remote, which remote/publish.sh fills with this file). One list for both: add a place here, not in code.","In order, the first executable file wins: 1) the PATH; 2) paths; 3) on a Mac, macPaths, where * is one path component and matches are tried newest version first; 4) on a Mac, macApps: each app found by bundle ID wherever it is (else the fallback paths), the paths inside it, then a file called search anywhere under Contents/Resources (5 levels).","~ is the home folder. macApps without inside or search only tell that the agent\'s desktop app is there."],"agents":{"claude":{"paths":["~/.local/bin/claude","~/.claude/local/claude","/opt/homebrew/bin/claude","/usr/local/bin/claude","~/.npm-global/bin/claude","~/.bun/bin/claude"],"macPaths":["~/Library/Application Support/Claude/claude-code/*/*/claude.app/Contents/MacOS/claude"],"macApps":[{"bundleIDs":["com.anthropic.claudefordesktop"],"fallback":["/Applications/Claude.app"]}]},"codex":{"paths":["~/.local/bin/codex","/opt/homebrew/bin/codex","/usr/local/bin/codex","~/.npm-global/bin/codex","~/.bun/bin/codex"],"macPaths":[],"macApps":[{"bundleIDs":["com.openai.codex","com.openai.chat"],"fallback":["/Applications/ChatGPT.app","/Applications/Codex.app"],"inside":["Contents/Resources/codex-cli/CodexCLI.app/Contents/MacOS/codex","Contents/Resources/codex-cli/bin/codex","Contents/Resources/codex"],"search":"codex"}]}}}')
